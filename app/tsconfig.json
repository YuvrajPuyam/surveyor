{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    // OFF (was on): certifyWorker.ts imports the headless core from ../src,
    // which compiles under root strict WITHOUT this flag; tsc applies one
    // option set per program, so keeping it on fails the root files.
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": ["src", "vite.config.ts"]
}
